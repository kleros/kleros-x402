{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "types": ["node"],
    // The linked @x402 packages must resolve their express types here, not in the x402 workspace.
    "preserveSymlinks": true
  },
  "include": ["**/*.ts"]
}
