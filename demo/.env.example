# facilitator.ts, variable names are x402's. EVM_RPC_URL defaults to Arbitrum's public RPC, which supports eth_simulateV1.
EVM_PRIVATE_KEY=0x...
CUSTOM_OPERATOR_ALLOWLIST=0x6B4E7055e0aDdB5F31A39b5f2719da843b1Bc4c9

# merchant.ts: the address paid, and the facilitator above.
EVM_ADDRESS=0x...
FACILITATOR_URL=http://localhost:4022

# buy.ts and settle.ts: the buyer's key pays, releases and disputes; the merchant's key, the one of EVM_ADDRESS, refunds.
BUYER_PRIVATE_KEY=0x...
MERCHANT_PRIVATE_KEY=0x...
# settle.ts dispute pins the agreement through Pinata.
PINATA_JWT=
